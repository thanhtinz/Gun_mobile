				resourceLink="asset.goldmine.num1,asset.goldmine.num2,asset.goldmine.num3,asset.goldmine.num4,asset.goldmine.num5,asset.goldmine.num6,asset.goldmine.num7,asset.goldmine.num8,asset.goldmine.num9,asset.goldmine.num0" />
