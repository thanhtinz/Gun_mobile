<customs>
		<custom classname="asset.rewardTask.view.help" stylename="asset.rewardTask.view.help" x="15" y="-56"/>
		<custom classname="flash.geom.Point" stylename="asset.rewardTask.goodPos" x="7.5" y="7" />

</customs>

<bitmaps>
	<bitmapData resourceLink="asset.rewardTask.bg" x="12" y="37" />
	<bitmapData resourceLink="asset.rewardTask.goodbg" x="0" y="0" />
	<bitmapData resourceLink="asset.rewardTask.multiplex" x="302" y="344" />
