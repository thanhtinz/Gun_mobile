	<component classname="com.pickgliss.ui.controls.TextButton" stylename="reward.taskStatus" 
			parentStyle='core.simplebt' backStyle="core.BigRedButton" 
			backgoundInnerRectString="8,88,6,30,13" textStyle="reward.taskStatusTxt" 
			width="150" height="50" x="329" y="483"/>
