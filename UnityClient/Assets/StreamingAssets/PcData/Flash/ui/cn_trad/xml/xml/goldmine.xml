<style name="goldmine" version="7.7.0" source="ui/cn_trad/swf/goldmine.swf">
	<sets>

		<set stylename="goldmineMainFrame.mineTimesTF" args="Arial,22,0xfff32c,true" type="flash.text.TextFormat" />
		<set stylename="goldmineMainFrame.mineTimesGF" args="0x781f10,1,4,4,20" type="flash.filters.GlowFilter" />		

		<set stylename="goldmineMainFrame.nextScoreNumTF" args="Arial,18,0xffedc4,true,,,,,center" type="flash.text.TextFormat" />
		<set stylename="goldmineMainFrame.nextScoreNumGF" args="0x781f10,1,4,4,20" type="flash.filters.GlowFilter" />	
		
		<set stylename="goldmineMainFrame.gradientTextLabelTF" args="Arial,18,0x000000,true" type="flash.text.TextFormat"/>
		<set stylename="goldmineMainFrame.gradientTextGF" args="0x781f10,1,4,4,20" type="flash.filters.GlowFilter"/>	
		
		<set stylename="goldmineMainFrame.introTextTF" args="Arial,14,0xffedc4,true" type="flash.text.TextFormat"/>
		<set stylename="goldmineMainFrame.introTextGF" args="0x781f10,1,4,4,20" type="flash.filters.GlowFilter"/>		
						
	</sets>

	<components>
		<component classname="com.pickgliss.ui.text.FilterFrameText"
			stylename="GoldmineInfoWord" textFormatStyle="goldmineMainFrame.introTextTF"
			filterString="goldmineMainFrame.introTextGF" autoSize="none" x="71" y="157" width="650"
			height="25" />	
		<component classname="goldmine.views.GoldmineMainFrame"
				closestyle="goldmine.closebt" backStyle="asset.goldmine.bg" 
				closeInnerRectString="38,-10,113,38,14" stylename="goldmine.frame"
				 x="130" y="16" escEnable="true" autoExit="true"
				width="741" height="522" />
