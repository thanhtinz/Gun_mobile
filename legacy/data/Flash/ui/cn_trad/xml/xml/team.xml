		<bitmapData resourceLink="asset.team.mainTab.unSelectGovern" x="6" />
		<bitmapData resourceLink="asset.team.mainTab.unSelectActive" x="6" />
		<bitmapData resourceLink="asset.team.mainTab.unSelectShop" x="6" />
		<bitmapData resourceLink="asset.team.mainTab.unSelectMember" x="6" />
		<custom classname="flash.geom.Point" stylename="team.govern.redPos" x="76" y="0"/>
