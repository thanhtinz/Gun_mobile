	<bitmapData resourceLink="asset.braveDoor.room.playerListBg"/>
	<bitmapData resourceLink="asset.braveDoor.room.homeownersIcon" x="178" y="42"/>
	<bitmapData resourceLink="asset.braveDoor.hadReady" x="175" y="26"/>
	<bitmapData resourceLink="asset.braveDoor.dropCellBgAsset" x="0" y="0" width="47" height="47"/>
	<bitmapData resourceLink="asset.braveDoor.duplicateDrop.bgIcon" x="20" y="166" width="293" height="173"/>
