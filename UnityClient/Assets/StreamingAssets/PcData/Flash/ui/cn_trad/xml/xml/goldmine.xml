		<component classname="com.pickgliss.ui.text.FilterFrameText" stylename="goldmineMainFrame.gradientTextLabel" textFormatStyle="goldmineMainFrame.gradientTextLabelTF" autoSize="none" width="500" height="30" isAutoFitLength="true"/>		
		
		
