<style name="rewardTask" version="1.0.0" source="ui/cn_trad/swf/rewardTask.swf">
<sets>
					
	<set stylename="rewardTask.taskDescriptionTextTF" args="Arial,14,0xFFECC2,true" type="flash.text.TextFormat" leading="6" />
	<set stylename="rewardTask.taskDescriptionTextGF" args="0x512800,1,2,2,10" type="flash.filters.GlowFilter"/>
	
	<set stylename="rewardTask.taskNumberTextTF" args="Arial,14,0xFF0000,true" type="flash.text.TextFormat"/>
	<set stylename="rewardTask.taskNumberTextGF" args="0xFFFFFF,1,2,2,10" type="flash.filters.GlowFilter"/>	
	
	<set stylename="rewardTask.vipBuyNumTextTF" args="Arial,12,0xFFECC2,true" type="flash.text.TextFormat"/>
	<set stylename="rewardTask.vipBuyNumTextGF" args="0x512800,1,2,2,10" type="flash.filters.GlowFilter"/>	
	
    <set stylename="reward.taskStatusTxt.tf" args="Arial,20,0xe3ffb4" type="flash.text.TextFormat"/>
    <set stylename="reward.taskStatusTxt.gf" args="0x006255,1,4,4,30" type="flash.filters.GlowFilter"/>
	
	<set stylename="rewardTask.tipsTF" args="Arial,16,0xe8ce97,true,,,,,left" type="flash.text.TextFormat" /> 
	<set stylename="rewardTask.tipsGF" args="0x471822,1,4,4,30" type="flash.filters.GlowFilter" />
	
    <set type="flash.text.TextFormat" stylename="rewardTask.rewardNameTextFormat" args="Arial,14,0xffea9c"/>

	<set type="flash.filters.GlowFilter" args="0x411212,2,4,4,30" stylename="rewardTask.rewardNameTextGF" />
</sets>
