		<component classname="com.pickgliss.ui.text.FilterFrameText" stylename="goldmineMainFrame.mineTimesText" textFormatStyle="goldmineMainFrame.mineTimesTF" filterString="goldmineMainFrame.mineTimesGF" x="133" y="438"/>
